{
  "url": "https://penetrationtestservices.com/agent/auth",
  "method": "GET",
  "headers": {
    "Authorization": "Bearer {{parameters.apiKey}}"
  },
  "response": {
    "error": {
      "message": "[{{statusCode}}] {{body.error}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.Authorization"
    ]
  }
}
